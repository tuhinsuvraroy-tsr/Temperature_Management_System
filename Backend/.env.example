# Copy this file to .env before starting the server. Do not commit .env.
PORT=3000

# Paste the complete MongoDB Atlas connection string here.
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@cluster0.2iafd4i.mongodb.net/
MONGODB_DATABASE=temperature_management

# Create an OAuth 2.0 Web client in Google Cloud Console and paste its client ID.
GOOGLE_CLIENT_ID=333206027250-ir3pkml8k4b15164rbp3i87j3e8sgh0r.apps.googleusercontent.com

# A long, random shared secret. It must match DEVICE_API_KEY in the Central ESP sketch.
DEVICE_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: comma-separated browser origins when the frontend is hosted separately.
# FRONTEND_ORIGINS=https://tmsnst.vercel.app,http://localhost:3000
